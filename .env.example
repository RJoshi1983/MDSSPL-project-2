# Copy these into Vercel → Project → Settings → Environment Variables.
# Leave them empty to run in DEMO MODE (no real accounts; data is lost on restart).

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase → Project Settings → API → anon / publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase → Project Settings → API → service_role / secret key (keep secret, server only)
SUPABASE_SERVICE_ROLE_KEY=
