# Main app (home page): Supabase project "Mdsspl Service Hub"
SUPABASE_URL=
# publishable key only (sb_publishable_...). Never the secret key.
SUPABASE_ANON_KEY=

# Add these in Render → your service → Environment.
# Leave them empty to run in DEMO MODE (no real accounts; data is lost on restart).

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase → Project Settings → API Keys → publishable / anon key (safe to be public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI assistant (optional). Get a key at console.anthropic.com → API Keys. Keep it secret.
# Without it the hub works normally and the assistant says it is not switched on.
ANTHROPIC_API_KEY=
# Optional: which Claude model to use (default claude-haiku-5-5) and questions per person per hour (default 30)
ANTHROPIC_MODEL=
ASSISTANT_MAX_PER_HOUR=

# Online payments (see README). Leave empty to hide "Pay online now".
PAY_GATEWAYS=razorpay,cashfree
PAY_CARD_FEE_PCT=2
PAY_UPI_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
