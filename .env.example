# Add these in Render → your service → Environment.
# Leave them empty to run in DEMO MODE (no real accounts; data is lost on restart).

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase → Project Settings → API Keys → publishable / anon key (safe to be public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
